{
  "data_version": 2,
  "command_timeout": 5,
  "templates_folder": "Templates",
  "templates_pairs": [
    [
      "{{title}}",
      "echo \"{{note_title}}\""
    ],
    [
      "{{date}}",
      "date +\"%d-%m-%Y\""
    ],
    [
      "{{day_after}}",
      "date -jf \"%d-%m-%Y\" -v+1d  \"{{note_title}}\" +\"%d-%m-%Y\""
    ],
    [
      "{{title_url}}",
      "input=\"{{note_title}}\"; input2=${input//&/%26};  echo ${input2// /%20}"
    ],
    [
      "{{time}}",
      "date +\"%H:%M\""
    ]
  ],
  "trigger_on_file_creation_mode": "folder",
  "auto_jump_to_cursor": true,
  "jump_to_cursor_after_file_name": false,
  "shell_path": "",
  "user_scripts_folder": "",
  "folder_templates": [],
  "file_templates": [],
  "syntax_highlighting": true,
  "syntax_highlighting_mobile": false,
  "enabled_templates_hotkeys": [],
  "startup_templates": [],
  "intellisense_render": "1",
  "ignore_folders_on_creation": [],
  "empty_file_template": "",
  "template_folder": "Templates",
  "locale": "en"
}